# Google Maps / Places (необязательно). Без ключа работает карта, импорт и демо-режим.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Необязательно: подключает Claude к ИИ-помощнику Доми. Без ключа работает локальный ИИ-режим.
ANTHROPIC_API_KEY=

# 1 — демо-режим для презентации: добавляются отзывы с источником «Демо-данные».
# 0 — рабочий режим: демо-отзывы удаляются, остаются только Google Places и импорт.
HOUSECHECK_SEED_DEMO=1
HOUSECHECK_SEED_ASTANA=1
